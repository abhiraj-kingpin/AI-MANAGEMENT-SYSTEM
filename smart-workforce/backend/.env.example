# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database
MONGO_URI=mongodb://localhost:27017/ai_management_system
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2

# Redis (caching, rate-limit store, BullMQ — used from Phase 6+ onward)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
QR_TOKEN_SECRET=change-me-qr-secret

# CORS — comma-separated list of allowed origins. Defaults to both local
# dev ports if unset (see config/env.ts), so this only needs to be set
# explicitly in deployed environments — e.g. on Render, set it to the
# real Vercel origin (no trailing slash):
#   CORS_ALLOWED_ORIGINS=https://ai-management-system-pearl.vercel.app
# List multiple origins comma-separated (e.g. to also allow a staging
# Vercel URL) with no spaces around the commas.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Cloudinary (media storage — used from Phase 4+ onward)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Cloud Messaging (push notifications — used from Phase 12 onward)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Email (password reset — used from Phase 3 onward)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Attendance tuning
FACE_MATCH_THRESHOLD=0.85
QR_DEFAULT_VALID_MINUTES=5

# Observability
SENTRY_DSN=
LOG_LEVEL=debug
