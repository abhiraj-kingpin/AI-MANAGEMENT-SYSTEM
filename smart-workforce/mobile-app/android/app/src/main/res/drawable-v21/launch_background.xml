<?xml version="1.0" encoding="utf-8"?>
<!-- See drawable/launch_background.xml (the non-v21 fallback) for why this
     uses the same fixed light background instead of ?android:colorBackground
     — the in-Flutter SplashScreen that takes over right after this is
     deliberately always-light (matches the rest of the app's screens, which
     also hardcode WPColors rather than following system dark mode), so this
     native frame should be too, or dark-mode devices would flash from a
     dark native background to a light Dart one. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background_color" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
