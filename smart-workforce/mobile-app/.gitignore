# Flutter/Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
*.g.dart
*.freezed.dart
# Regenerated by every `flutter pub get` — legacy plugin-registration files
# the tool still writes but no longer reads from; pubspec.lock (committed,
# same reasoning as package-lock.json for the Node projects) is what
# actually pins dependency versions.
.flutter-plugins
.flutter-plugins-dependencies

# Generated platform folders (create with `flutter create .` — see README.md)
# Uncomment once android/ and ios/ exist and you want their build output ignored:
# android/.gradle/
# android/app/build/
# ios/Pods/
# ios/.symlinks/

# IDE
.vscode/
.idea/
*.iml

# Env
.env

# macOS
.DS_Store

# Signing — the production keystore and its passwords must NEVER be
# committed. Losing this file/these values means losing the ability to ship
# updates to the same Play Store listing under the same signing identity —
# back it up outside git (see android/key.properties.example for the format
# key.properties itself must follow).
android/key.properties
*.jks
*.keystore
